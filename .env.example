# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID — alerts will be sent here
# Leave blank to set via /start command in the bot
TELEGRAM_CHAT_ID=

# Solana RPC URL (optional for now, used if on-chain reads needed)
# Free options: https://helius.dev, https://quicknode.com
SOLANA_RPC_URL=

# Polling interval in milliseconds (default: 60 seconds)
POLL_INTERVAL_MS=60000

# Proximity warning threshold in bins (default: 5)
PROXIMITY_THRESHOLD=5
